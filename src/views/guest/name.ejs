<%- include('../partials/head', { title: event.name, template: event.template, csrfToken: csrfToken }) %>
<div class="center-screen">
  <div class="card container-narrow stack">
    <div class="text-center">
      <h1>Willkommen 👋</h1>
      <p class="text-muted">Wie heisst du? Dein Name wird nur gespeichert, damit deine Fotos zugeordnet werden koennen.</p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/e/<%= event.id %>/name" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="firstName">Vorname</label>
        <input type="text" id="firstName" name="firstName" required autofocus maxlength="80">
      </div>
      <div class="field">
        <label for="lastName">Nachname</label>
        <input type="text" id="lastName" name="lastName" required maxlength="80">
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Los geht's</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
