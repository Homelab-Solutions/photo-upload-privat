<%- include('../partials/head', { title: event.name, template: event.template, csrfToken: csrfToken }) %>
<div class="center-screen">
  <div class="card container-narrow stack">
    <div class="text-center">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="width:48px;height:48px;color:var(--color-primary);margin:0 auto 10px;">
        <path d="M4 8h3l2-2h6l2 2h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/>
        <circle cx="12" cy="13" r="3.5"/>
      </svg>
      <h1><%= event.name %></h1>
      <p class="text-muted">Gib das Event-Passwort ein, um Fotos hochzuladen oder die Galerie zu sehen.</p>
    </div>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <form method="POST" action="/e/<%= event.id %>/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="password">Event-Passwort</label>
        <input type="password" id="password" name="password" value="<%= prefillPwd || '' %>" autocomplete="off" required autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg">Weiter</button>
    </form>
  </div>
</div>
<%- include('../partials/foot') %>
