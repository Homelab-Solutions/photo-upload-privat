<%- include('../partials/head', { title: 'Ergebnis', template: event.template }) %>
<div class="center-screen">
  <div class="card container-narrow stack text-center">
    <h1><%= success %> von <%= total %> Dateien hochgeladen</h1>
    <p class="text-muted">Deine Fotos werden vom Gastgeber geprueft und erscheinen danach in der Galerie.</p>
    <% if (errors && errors.length) { %>
      <div class="alert alert-error text-sm" style="text-align:left;">
        <strong>Nicht hochgeladen:</strong>
        <ul style="margin:6px 0 0 18px;padding:0;">
          <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
        </ul>
      </div>
    <% } %>
    <div class="row" style="justify-content:center;">
      <a href="/e/<%= event.id %>/upload" class="btn btn-secondary">Weitere hochladen</a>
      <a href="/e/<%= event.id %>" class="btn btn-primary">Fertig</a>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
