<%- include('../partials/head', { title: event.name, template: event.template }) %>
<div class="center-screen">
  <div class="container-narrow stack">
    <div class="text-center">
      <h1><%= event.name %></h1>
      <p class="text-muted">Schoen, dass du dabei bist, <%= guestName %>!</p>
    </div>

    <div class="big-choice-grid mt-2">
      <a class="big-choice" href="/e/<%= event.id %>/upload">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M12 16V4M12 4l-4 4M12 4l4 4"/>
          <path d="M4 16v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/>
        </svg>
        <strong>Fotos hochladen</strong>
        <span class="text-muted text-sm">Bilder &amp; Videos teilen</span>
      </a>
      <a class="big-choice" href="/e/<%= event.id %>/gallery">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="3"/>
          <circle cx="8.5" cy="9" r="1.8"/>
          <path d="M21 16l-5.5-5.5a2 2 0 0 0-2.8 0L4 19"/>
        </svg>
        <strong>Galerie ansehen</strong>
        <span class="text-muted text-sm">Freigegebene Fotos entdecken</span>
      </a>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
