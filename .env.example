# Pflicht: Passwort fuer den Admin-Login
ADMIN_PASSWORD=change-me-please

# Geheimnis zum Signieren der Session-Cookies (langer, zufaelliger String)
SESSION_SECRET=change-me-too-please

# Port, auf dem die App im Container lauscht
PORT=3005

# Oeffentliche Basis-URL der App (wichtig fuer QR-Codes hinter Reverse Proxy)
# Beispiel: https://fotos.meine-domain.de
BASE_URL=http://localhost:3005

# Maximale Upload-Groessen (in MB)
MAX_UPLOAD_SIZE_IMAGE=20
MAX_UPLOAD_SIZE_VIDEO=100

# Auf true setzen, wenn die App hinter einem Reverse Proxy laeuft (Nginx Proxy Manager etc.)
TRUST_PROXY=true
